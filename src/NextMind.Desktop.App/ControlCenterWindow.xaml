<Window x:Class="NextMind.Desktop.App.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NextMind Future Workspace" Width="760" Height="780" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterScreen" Style="{StaticResource FutureWindowStyle}" PreviewKeyDown="Root_PreviewKeyDown">
  <Grid Background="{DynamicResource FutureCanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="FutureTitleBar" Background="{DynamicResource FuturePanelRaisedBrush}"
            BorderBrush="{DynamicResource FutureBorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="14,0,0,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="NEXTMIND" Foreground="{DynamicResource FutureAccentBrush}" FontWeight="SemiBold" FontSize="12"/>
          <TextBlock Text="  FUTURE WORKSPACE" Foreground="{DynamicResource FutureTextBrush}" FontWeight="SemiBold" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="─" Style="{StaticResource FutureChromeButtonStyle}" Click="MinimizeWindow_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize window" ToolTip="Minimize"/>
          <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource FutureChromeButtonStyle}" Click="MaximizeRestoreWindow_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize or restore window" ToolTip="Maximize"/>
          <Button Content="×" Style="{StaticResource FutureChromeCloseButtonStyle}" Click="CloseWindow_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close window" ToolTip="Close"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource FuturisticWindowHeaderStyle}">
      <Grid>
        <StackPanel><TextBlock Text="NEXTMIND // FUTURE WORKSPACE" Style="{StaticResource FutureSectionLabelStyle}"/><TextBlock Text="Control Center" FontSize="26" FontWeight="Light"/><TextBlock Text="Local modular desktop · V3 · Live Preview 2" Style="{StaticResource FutureMutedTextStyle}"/></StackPanel>
        <Button Content="⌕  COMMAND SEARCH" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource FuturisticPrimaryButtonStyle}" Click="Search_Click" ToolTip="Search (Ctrl+K)"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource FuturisticScrollViewerStyle}">
      <StackPanel Margin="18">
        <Border Style="{StaticResource HolographicPanelStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="WORKSPACE PROFILES" Style="{StaticResource FutureSectionLabelStyle}"/><TextBlock Text="Independent layouts for every context" Style="{StaticResource FutureCardTitleStyle}" Margin="0,3,0,10"/><StackPanel x:Name="ProfileRows"/><Button Content="＋  NEW PROFILE" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource FuturisticPrimaryButtonStyle}" Click="CreateProfile_Click"/></StackPanel></Border>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource HolographicPanelStyle}"><StackPanel><TextBlock Text="WIDGET MODULES" Style="{StaticResource FutureSectionLabelStyle}"/><TextBlock Text="Live workspace surfaces" Style="{StaticResource FutureCardTitleStyle}" Margin="0,3,0,10"/><WrapPanel x:Name="WidgetCatalogButtons"/><StackPanel x:Name="WidgetRows" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource HolographicPanelStyle}"><StackPanel><TextBlock Text="ZONE MATRIX" Style="{StaticResource FutureSectionLabelStyle}"/><TextBlock Text="Desktop containers" Style="{StaticResource FutureCardTitleStyle}" Margin="0,3,0,10"/><StackPanel x:Name="ZoneRows"/><Button x:Name="CreateButton" Content="＋  CREATE ZONE" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource FuturisticPrimaryButtonStyle}" Click="Create_Click"/></StackPanel></Border>
        </Grid>
        <Border Style="{StaticResource HolographicPanelStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="LAYOUT ENGINE" Style="{StaticResource FutureSectionLabelStyle}"/><TextBlock Text="Assisted positioning without changing ownership" Style="{StaticResource FutureCardTitleStyle}" Margin="0,3,0,10"/>
          <WrapPanel><CheckBox x:Name="SnapElementsBox" Content="Snap to zones" Margin="0,5,22,5" Style="{StaticResource FuturisticToggleStyle}"/><CheckBox x:Name="SnapGridBox" Content="Snap to grid" Margin="0,5,22,5" Style="{StaticResource FuturisticToggleStyle}"/></WrapPanel>
          <WrapPanel Margin="0,8,0,0"><TextBlock Text="GRID" Style="{StaticResource FutureSectionLabelStyle}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="GridSizeBox" Width="58" Style="{StaticResource FuturisticTextBoxStyle}"/><TextBlock Text="GAP" Style="{StaticResource FutureSectionLabelStyle}" VerticalAlignment="Center" Margin="18,0,7,0"/><TextBox x:Name="GapBox" Width="58" Style="{StaticResource FuturisticTextBoxStyle}"/></WrapPanel>
          <WrapPanel Margin="0,12,0,0"><Button Content="APPLY LAYOUT" Style="{StaticResource FuturisticPrimaryButtonStyle}" Click="ApplyLayout_Click" Margin="0,0,8,8"/><Button Content="AUTO-ARRANGE" Style="{StaticResource FuturisticButtonStyle}" Click="AutoArrange_Click" Margin="0,0,8,8"/><Button x:Name="UndoMoveButton" Content="UNDO MOVE" Style="{StaticResource FuturisticButtonStyle}" Click="UndoMove_Click" Margin="0,0,8,8"/></WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource HolographicPanelStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="VISUAL CALIBRATION" Style="{StaticResource FutureSectionLabelStyle}"/><TextBlock Text="Tune glass, light and motion" Style="{StaticResource FutureCardTitleStyle}" Margin="0,3,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Glow intensity" VerticalAlignment="Center"/><Slider x:Name="GlowSlider" Grid.Column="1" Minimum="0" Maximum="100" Style="{StaticResource FuturisticSliderStyle}"/><TextBlock x:Name="GlowValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="Panel opacity" VerticalAlignment="Center"/><Slider x:Name="OpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="55" Maximum="100" Style="{StaticResource FuturisticSliderStyle}"/><TextBlock x:Name="OpacityValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="2" Text="Accent" VerticalAlignment="Top" Margin="0,20,0,0"/>
            <ListBox x:Name="AccentBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" SelectedIndex="0"
                     Style="{StaticResource FuturisticAccentSelectorStyle}" ItemContainerStyle="{StaticResource FuturisticAccentItemStyle}"
                     AutomationProperties.Name="Workspace accent color">
              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBoxItem Tag="ElectricBlue"><StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="{StaticResource AccentElectricBlueBrush}" Margin="0,0,7,0"/><TextBlock Text="Electric Blue"/></StackPanel></ListBoxItem>
              <ListBoxItem Tag="Cyan"><StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,7,0"/><TextBlock Text="Cyan"/></StackPanel></ListBoxItem>
              <ListBoxItem Tag="Violet"><StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="{StaticResource AccentVioletBrush}" Margin="0,0,7,0"/><TextBlock Text="Violet"/></StackPanel></ListBoxItem>
              <ListBoxItem Tag="Amber"><StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="{StaticResource AccentAmberBrush}" Margin="0,0,7,0"/><TextBlock Text="Amber"/></StackPanel></ListBoxItem>
            </ListBox>
          </Grid>
          <WrapPanel Margin="0,12,0,0"><CheckBox x:Name="AnimationsBox" Content="Animations" Margin="0,5,24,5" Style="{StaticResource FuturisticToggleStyle}"/><CheckBox x:Name="ResourceSaverBox" Content="Resource saver" Margin="0,5,24,5" Style="{StaticResource FuturisticToggleStyle}"/></WrapPanel>
          <WrapPanel Margin="0,12,0,0"><Button Content="APPLY APPEARANCE" Style="{StaticResource FuturisticPrimaryButtonStyle}" Click="ApplyAppearance_Click" Margin="0,0,8,0"/><Button Content="RESET STYLE" Style="{StaticResource FuturisticButtonStyle}" Click="ResetAppearance_Click"/></WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource HolographicPanelStyle}"><StackPanel><TextBlock Text="SYSTEM &amp; SAFETY" Style="{StaticResource FutureSectionLabelStyle}"/><CheckBox x:Name="AutostartBox" Content="Start with Windows" Margin="0,12,0,0" Style="{StaticResource FuturisticToggleStyle}" Click="Autostart_Click"/><WrapPanel Margin="0,12,0,0"><Button Content="HIDE ALL ZONES" Style="{StaticResource FuturisticButtonStyle}" Click="HideAll_Click" Margin="0,0,8,8"/><Button Content="SHOW ALL ZONES" Style="{StaticResource FuturisticButtonStyle}" Click="ShowAll_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="GateText" Margin="0,10,0,0" Style="{StaticResource FutureMutedTextStyle}" TextWrapping="Wrap"/></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" Style="{StaticResource FuturisticWindowHeaderStyle}"><Grid><TextBlock Text="LOCAL-ONLY // NO CLOUD // SAFETY GATES ACTIVE" Style="{StaticResource FutureMutedTextStyle}" VerticalAlignment="Center"/><Button Content="EXIT NEXTMIND" HorizontalAlignment="Right" Style="{StaticResource FuturisticDangerButtonStyle}" Click="Exit_Click"/></Grid></Border>
  </Grid>
</Window>
