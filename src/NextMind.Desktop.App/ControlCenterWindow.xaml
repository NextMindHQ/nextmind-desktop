<Window x:Class="NextMind.Desktop.App.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextMind Desktop"
        SizeToContent="Height" Width="520" MinWidth="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1F27" Foreground="#FFF0F4F8"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
  </Window.Resources>
  <StackPanel Margin="24,20,24,22">
    <TextBlock Text="NEXTMIND DESKTOP" FontSize="17" FontWeight="SemiBold" />
    <TextBlock Text="Zones" Margin="0,18,0,8" FontSize="13" Foreground="#FF8C98A8" />
    <StackPanel x:Name="ZoneRows" />
    <Button x:Name="CreateButton" Content="+  Create Zone" Margin="0,12,0,0" HorizontalAlignment="Left" Click="Create_Click" />

    <TextBlock Text="Layout" Margin="0,20,0,8" FontSize="13" Foreground="#FF8C98A8" />
    <WrapPanel>
      <CheckBox x:Name="SnapElementsBox" Content="Snap to zones" Margin="0,5,18,0" Foreground="#FFF0F4F8" />
      <CheckBox x:Name="SnapGridBox" Content="Snap to grid" Margin="0,5,18,0" Foreground="#FFF0F4F8" />
      <TextBlock Text="Grid" VerticalAlignment="Center" Margin="0,4,5,0" />
      <TextBox x:Name="GridSizeBox" Width="42" Margin="0,4,12,0" VerticalContentAlignment="Center" />
      <TextBlock Text="Gap" VerticalAlignment="Center" Margin="0,4,5,0" />
      <TextBox x:Name="GapBox" Width="42" Margin="0,4,0,0" VerticalContentAlignment="Center" />
    </WrapPanel>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="Apply Layout Settings" Margin="0" Click="ApplyLayout_Click" />
      <Button Content="Auto-arrange" Click="AutoArrange_Click" />
      <Button x:Name="UndoMoveButton" Content="Undo Move" Click="UndoMove_Click" />
    </StackPanel>

    <CheckBox x:Name="AutostartBox" Content="Start with Windows" Margin="0,22,0,0" Click="Autostart_Click" Foreground="#FFF0F4F8" />

    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="Hide All Zones" Margin="0" Click="HideAll_Click" />
      <Button Content="Show All Zones" Click="ShowAll_Click" />
    </StackPanel>

    <TextBlock x:Name="GateText" Margin="0,18,0,0" FontSize="12" Foreground="#FF8C98A8" TextWrapping="Wrap" />

    <Button Content="Exit NextMind Desktop" Margin="0,18,0,0" HorizontalAlignment="Left" Click="Exit_Click" />
  </StackPanel>
</Window>
