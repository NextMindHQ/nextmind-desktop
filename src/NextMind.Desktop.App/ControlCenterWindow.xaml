<Window x:Class="NextMind.Desktop.App.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextMind Desktop"
        SizeToContent="Height" Width="460" MinWidth="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1F27" Foreground="#FFF0F4F8"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
  </Window.Resources>
  <StackPanel Margin="24,20,24,22">
    <TextBlock Text="NEXTMIND DESKTOP" FontSize="17" FontWeight="SemiBold" />
    <TextBlock Text="Zones" Margin="0,18,0,8" FontSize="13" Foreground="#FF8C98A8" />
    <StackPanel x:Name="ZoneRows" />
    <Button x:Name="CreateButton" Content="+  Create Zone" Margin="0,12,0,0" HorizontalAlignment="Left" Click="Create_Click" />

    <CheckBox x:Name="AutostartBox" Content="Start with Windows" Margin="0,22,0,0" Click="Autostart_Click" Foreground="#FFF0F4F8" />

    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="Hide All Zones" Margin="0" Click="HideAll_Click" />
      <Button Content="Show All Zones" Click="ShowAll_Click" />
    </StackPanel>

    <TextBlock x:Name="GateText" Margin="0,18,0,0" FontSize="12" Foreground="#FF8C98A8" TextWrapping="Wrap" />

    <Button Content="Exit NextMind Desktop" Margin="0,18,0,0" HorizontalAlignment="Left" Click="Exit_Click" />
  </StackPanel>
</Window>
