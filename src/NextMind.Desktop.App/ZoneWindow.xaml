<Window x:Class="NextMind.Desktop.App.ZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NextMind.Desktop.App"
        Title="NextMind Zone"
        Width="320" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowActivated="False" Topmost="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewDragEnter="Zone_DragEnter" PreviewDragOver="Zone_DragOver"
        PreviewDragLeave="Zone_DragLeave" PreviewDrop="Zone_Drop"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji">

  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#EE181C24" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="DropBorderBrush" Color="#CC5AA9FF" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F0F4F8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8C98A8" />

    <Style x:Key="GripThumb" TargetType="Thumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small title-bar button: transparent, subtle hover. -->
    <Style x:Key="ChromeButton" TargetType="Border">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#33FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CloseButton" TargetType="Border" BasedOn="{StaticResource ChromeButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#99E5484D" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ItemContainer" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <!-- A 2 px left edge is always reserved; the drop indicator only changes its colour, so nothing shifts while dragging. -->
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <EventSetter Event="MouseDoubleClick" Handler="Item_MouseDoubleClick" />
      <EventSetter Event="ContextMenuOpening" Handler="Item_ContextMenuOpening" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="2"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4A5AA9FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>

    </Style>

    <DataTemplate DataType="{x:Type local:ItemViewModel}">
      <StackPanel Width="78" ToolTip="{Binding Tooltip}" Background="Transparent">
        <Grid Width="32" Height="32" Margin="0,4,0,0" HorizontalAlignment="Center">
          <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
          <Border Visibility="{Binding MissingVisibility}" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1.5"
                  CornerRadius="5" Opacity="0.8">
            <TextBlock Text="?" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource TextBrush}" TextAlignment="Center"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="1,5,1,4" />
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMissing}" Value="True">
                <Setter Property="Opacity" Value="0.5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" CornerRadius="10" Background="{StaticResource PanelBrush}"
          BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" ClipToBounds="True" AllowDrop="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Title bar: drag to move; double-click or the arrow collapses/expands; right-click for the zone menu. -->
      <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="9,9,0,0"
              AllowDrop="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Border.ContextMenu>
          <ContextMenu Opened="ZoneMenu_Opened">
            <MenuItem Header="Rename Zone" Click="Rename_Click" />
            <MenuItem x:Name="SortMenu" Header="Sort by">
              <MenuItem Header="Custom" Tag="Custom" Click="Sort_Click" />
              <MenuItem Header="Name A → Z" Tag="NameAscending" Click="Sort_Click" />
              <MenuItem Header="Name Z → A" Tag="NameDescending" Click="Sort_Click" />
              <MenuItem Header="Date Added — Newest" Tag="AddedNewest" Click="Sort_Click" />
              <MenuItem Header="Date Added — Oldest" Tag="AddedOldest" Click="Sort_Click" />
              <MenuItem Header="Type" Tag="Type" Click="Sort_Click" />
            </MenuItem>
            <MenuItem Header="Hide Zone" Click="Hide_Click" />
            <Separator />
            <MenuItem Header="Delete Zone" Click="Delete_Click" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid Margin="12,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Title + arrow: the arrow always sits directly after the name; only its direction changes. -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Border x:Name="ToggleArrow" Background="Transparent" Padding="8,8,8,8" Cursor="Hand"
                    ToolTip="Collapse / expand" MouseLeftButtonDown="ToggleArrow_MouseLeftButtonDown">
              <Path x:Name="ArrowPath" Data="M0,0 L6,4.5 L0,9 Z" Fill="{StaticResource MutedBrush}"
                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform x:Name="ArrowRotation" Angle="90" />
                </Path.RenderTransform>
              </Path>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="MinButton" Style="{StaticResource ChromeButton}" ToolTip="Collapse to title bar"
                    MouseLeftButtonDown="MinButton_MouseLeftButtonDown">
              <Path Data="M0,0 L10,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0" />
            </Border>
            <Border x:Name="CloseButton" Style="{StaticResource CloseButton}" ToolTip="Hide this zone (Show / Hide Zones in the tray brings it back)"
                    MouseLeftButtonDown="CloseButton_MouseLeftButtonDown">
              <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Items: wrap grid, left-to-right then down; the column count follows the width; scrolls vertically. -->
      <Grid x:Name="ContentArea" Grid.Row="1" AllowDrop="True">
        <TextBlock x:Name="EmptyHint" Text="Drop files, folders or shortcuts here" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Opacity="0.6" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Margin="4,2,8,8" AllowDrop="True"
                 SelectionMode="Single" ItemContainerStyle="{StaticResource ItemContainer}"
                 PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown" PreviewMouseMove="Items_PreviewMouseMove"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </Grid>

      <!-- Resize handles (hidden while collapsed). -->
      <Thumb x:Name="RightGrip" Grid.Row="1" Style="{StaticResource GripThumb}" HorizontalAlignment="Right"
             Width="6" Margin="0,0,0,14" Cursor="SizeWE" DragDelta="RightGrip_DragDelta" DragCompleted="Grip_DragCompleted" />
      <Thumb x:Name="BottomGrip" Grid.Row="1" Style="{StaticResource GripThumb}" VerticalAlignment="Bottom"
             Height="6" Margin="0,0,14,0" Cursor="SizeNS" DragDelta="BottomGrip_DragDelta" DragCompleted="Grip_DragCompleted" />
      <Thumb x:Name="CornerGrip" Grid.Row="1" Style="{StaticResource GripThumb}" HorizontalAlignment="Right"
             VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNWSE"
             DragDelta="CornerGrip_DragDelta" DragCompleted="Grip_DragCompleted" />
      <Path x:Name="CornerMark" Grid.Row="1" Data="M10,2 L2,10 M10,6 L6,10" Stroke="{StaticResource MutedBrush}"
            StrokeThickness="1" Opacity="0.6" Width="12" Height="12" HorizontalAlignment="Right"
            VerticalAlignment="Bottom" Margin="0,0,3,3" IsHitTestVisible="False" />
    </Grid>
  </Border>
</Window>
