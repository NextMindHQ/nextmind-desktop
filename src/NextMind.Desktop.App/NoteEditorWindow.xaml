<Window x:Class="NextMind.Desktop.App.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Note" Width="520" Height="390" MinWidth="380" MinHeight="280"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#FF1B1F27" Foreground="#FFF0F4F8"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Note text is stored locally in your active workspace profile." Foreground="#FF8C98A8" />
    <TextBox x:Name="Input" Grid.Row="1" Margin="0,10,0,12" Padding="9" FontSize="14"
             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
             Background="#FF262B35" Foreground="#FFF0F4F8" CaretBrush="White" BorderBrush="#55FFFFFF" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Save" MinWidth="88" Padding="14,6" Margin="0,0,10,0" Click="Save_Click" />
      <Button Content="Cancel" MinWidth="88" Padding="14,6" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
