<Window x:Class="NextMind.Desktop.App.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Note" Width="520" Height="390" MinWidth="380" MinHeight="280"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Style="{StaticResource FutureWindowStyle}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="QUICK NOTE // LOCAL PROFILE STORAGE" Style="{StaticResource FutureSectionLabelStyle}" />
    <TextBox x:Name="Input" Grid.Row="1" Margin="0,10,0,12" Padding="9" FontSize="14"
             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
             Style="{StaticResource FuturisticTextBoxStyle}" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="SAVE NOTE" MinWidth="100" Margin="0,0,10,0" Style="{StaticResource FuturisticPrimaryButtonStyle}" Click="Save_Click" />
      <Button Content="CANCEL" MinWidth="88" Style="{StaticResource FuturisticButtonStyle}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
