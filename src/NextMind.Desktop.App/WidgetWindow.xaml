<Window x:Class="NextMind.Desktop.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NextMind.Desktop.App"
        Title="NextMind Widget" Width="260" Height="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowActivated="False" Topmost="False"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#EE101925" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#705E7895" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEF6FF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#91A4B8" />
    <Style TargetType="Button" BasedOn="{StaticResource FuturisticButtonStyle}">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
  </Window.Resources>
  <Border x:Name="Root" CornerRadius="10" Background="Transparent"
          BorderBrush="{DynamicResource WorkspaceAccentSoftBrush}" BorderThickness="1" ClipToBounds="True"
          Effect="{DynamicResource WorkspacePanelEffect}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="{DynamicResource FuturePanelAltBrush}" CornerRadius="9,9,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="10,0,5,0">
          <TextBlock x:Name="TitleText" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                     FontSize="13" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="CollapseButton" Content="—" Width="28" Height="23" Padding="0" ToolTip="Collapse / expand" Click="Collapse_Click" />
            <Button Content="×" Width="28" Height="23" Padding="0" ToolTip="Remove widget" Click="Remove_Click" />
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="ContentSurface" Grid.Row="1" Background="{DynamicResource WorkspaceContentBrush}" CornerRadius="0,0,9,9">
      <Grid x:Name="ContentArea" Margin="12,8,12,12">
        <local:ClockWidgetContent x:Name="ClockPanel" />
        <Grid x:Name="NotePanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource FuturisticScrollViewerStyle}">
            <TextBlock x:Name="NoteText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" FontSize="14" />
          </ScrollViewer>
          <Button Grid.Row="1" Content="Edit Note" HorizontalAlignment="Right" Margin="0,8,0,0" Click="EditNote_Click" />
        </Grid>
      </Grid>
      </Border>
      <Thumb x:Name="RightGrip" Grid.Row="1" HorizontalAlignment="Right" Width="6" Cursor="SizeWE"
             Style="{StaticResource FuturisticResizeThumbStyle}"
             DragDelta="RightGrip_DragDelta" DragCompleted="Grip_DragCompleted" />
      <Thumb x:Name="BottomGrip" Grid.Row="1" VerticalAlignment="Bottom" Height="6" Cursor="SizeNS"
             Style="{StaticResource FuturisticResizeThumbStyle}"
             DragDelta="BottomGrip_DragDelta" DragCompleted="Grip_DragCompleted" />
      <Thumb x:Name="CornerGrip" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
             Width="14" Height="14" Cursor="SizeNWSE" Style="{StaticResource FuturisticResizeThumbStyle}"
             DragDelta="CornerGrip_DragDelta" DragCompleted="Grip_DragCompleted" />
      <Path x:Name="CornerMark" Grid.Row="1" Data="M10,2 L2,10 M10,6 L6,10" Stroke="{DynamicResource WorkspaceAccentBrush}"
            StrokeThickness="1" Opacity="0.65" Width="12" Height="12" HorizontalAlignment="Right"
            VerticalAlignment="Bottom" Margin="0,0,3,3" IsHitTestVisible="False" />
    </Grid>
  </Border>
</Window>
