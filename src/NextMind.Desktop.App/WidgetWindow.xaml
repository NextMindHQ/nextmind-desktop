<Window x:Class="NextMind.Desktop.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextMind Widget" Width="260" Height="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowActivated="False" Topmost="False"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#EE101925" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#705E7895" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEF6FF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#91A4B8" />
    <Style x:Key="GripThumb" TargetType="Thumb" xmlns:sys="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource FuturisticButtonStyle}">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
  </Window.Resources>
  <Border x:Name="Root" CornerRadius="10" Background="{StaticResource PanelBrush}"
          BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" ClipToBounds="True"
          Effect="{DynamicResource FuturePanelEffect}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="{DynamicResource FuturePanelAltBrush}" CornerRadius="9,9,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="10,0,5,0">
          <TextBlock x:Name="TitleText" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                     FontSize="13" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="CollapseButton" Content="—" Width="28" Height="23" Padding="0" ToolTip="Collapse / expand" Click="Collapse_Click" />
            <Button Content="×" Width="28" Height="23" Padding="0" ToolTip="Remove widget" Click="Remove_Click" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="ContentArea" Grid.Row="1" Margin="12,8,12,12">
        <StackPanel x:Name="ClockPanel" VerticalAlignment="Center">
          <TextBlock Text="LOCAL TIME" Foreground="{DynamicResource FutureAccentBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="ClockTime" Foreground="{StaticResource TextBrush}" FontSize="38" FontWeight="Light"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="ClockDate" Foreground="{StaticResource MutedBrush}" FontSize="13"
                     HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
        <Grid x:Name="NotePanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="NoteText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" FontSize="14" />
          </ScrollViewer>
          <Button Grid.Row="1" Content="Edit Note" HorizontalAlignment="Right" Margin="0,8,0,0" Click="EditNote_Click" />
        </Grid>
      </Grid>
      <Thumb x:Name="RightGrip" Grid.Row="1" HorizontalAlignment="Right" Width="6" Cursor="SizeWE"
             DragDelta="RightGrip_DragDelta" DragCompleted="Grip_DragCompleted" />
      <Thumb x:Name="BottomGrip" Grid.Row="1" VerticalAlignment="Bottom" Height="6" Cursor="SizeNS"
             DragDelta="BottomGrip_DragDelta" DragCompleted="Grip_DragCompleted" />
      <Thumb x:Name="CornerGrip" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
             Width="14" Height="14" Cursor="SizeNWSE" DragDelta="CornerGrip_DragDelta" DragCompleted="Grip_DragCompleted" />
    </Grid>
  </Border>
</Window>
