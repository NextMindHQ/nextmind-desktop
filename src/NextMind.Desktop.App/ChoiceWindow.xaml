<Window x:Class="NextMind.Desktop.App.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextMind Desktop"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" MinWidth="420"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#FF1B1F27" Foreground="#FFF0F4F8"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji">
  <StackPanel Margin="22,20,22,18">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="500" FontSize="14" LineHeight="21" />
    <StackPanel x:Name="Buttons" Orientation="Vertical" Margin="0,20,0,0" />
  </StackPanel>
</Window>
