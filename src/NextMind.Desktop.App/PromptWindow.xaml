<Window x:Class="NextMind.Desktop.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextMind Desktop"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" MinWidth="380"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Style="{StaticResource FutureWindowStyle}">
  <StackPanel Margin="22,20,22,18">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="440" FontSize="14" />
    <TextBox x:Name="Input" Margin="0,12,0,0" Padding="7,6" FontSize="14" MaxLength="80"
             Style="{StaticResource FuturisticTextBoxStyle}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="OkButton" MinWidth="88" Margin="0,0,10,0" Style="{StaticResource FuturisticPrimaryButtonStyle}" Click="Ok_Click" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" Style="{StaticResource FuturisticButtonStyle}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
