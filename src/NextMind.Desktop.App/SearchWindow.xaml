<Window x:Class="NextMind.Desktop.App.SearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextMind Command Search" Width="620" Height="500" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource FutureWindowStyle}" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/FutureTheme.xaml"/></ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="SearchResultTemplate">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource FutureAccentSoftBrush}" BorderBrush="{DynamicResource FutureAccentBrush}" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="0,0,11,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Entry.Kind}" Foreground="{DynamicResource FutureAccentBrush}" FontSize="9" FontWeight="SemiBold"/>
        </Border>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Entry.Title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Entry.Subtitle}" FontSize="11.5" Foreground="{DynamicResource FutureMutedTextBrush}" Margin="0,2,0,0"/></StackPanel>
      </Grid>
    </DataTemplate>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FuturisticSearchResultStyle}"><EventSetter Event="MouseDoubleClick" Handler="Result_DoubleClick"/></Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource FutureCanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource FuturisticWindowHeaderStyle}"><StackPanel><TextBlock Text="NEXTMIND // COMMAND MATRIX" Style="{StaticResource FutureSectionLabelStyle}"/><TextBlock Text="Search workspace" FontSize="23" FontWeight="Light"/></StackPanel></Border>
    <Border Grid.Row="1" Style="{StaticResource HolographicPanelStyle}" Margin="16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="⌕" FontSize="23" Foreground="{DynamicResource FutureAccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBox x:Name="QueryBox" Margin="42,0,0,0" FontSize="17" Style="{StaticResource FuturisticTextBoxStyle}" TextChanged="Query_TextChanged" ToolTip="Search applications, zones, widgets and commands"/></Grid>
        <Grid Grid.Row="1" Margin="0,12,0,0"><ListBox x:Name="ResultsList" ItemTemplate="{StaticResource SearchResultTemplate}" Background="Transparent" BorderThickness="0"/>
          <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="⌁" FontSize="30" Foreground="{DynamicResource FutureAccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="TYPE TO SEARCH" Foreground="{DynamicResource FutureMutedTextBrush}" FontSize="11" FontWeight="SemiBold"/></StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource FuturisticWindowHeaderStyle}"><TextBlock Text="↑ ↓  NAVIGATE     ENTER  EXECUTE     ESC  CLOSE" Style="{StaticResource FutureMutedTextStyle}" HorizontalAlignment="Center"/></Border>
  </Grid>
</Window>
