<Window x:Class="NextMind.Desktop.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search NextMind Desktop" Width="560" Height="430" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen" Background="#FF1B1F27" Foreground="#FFF0F4F8"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <DataTemplate x:Key="SearchResultTemplate">
      <Border Padding="10,8" CornerRadius="7" Background="Transparent">
        <StackPanel>
          <TextBlock Text="{Binding Entry.Title}" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Entry.Subtitle}" FontSize="11.5" Foreground="#FF8C98A8" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="0" />
      <EventSetter Event="MouseDoubleClick" Handler="Result_DoubleClick" />
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBox x:Name="QueryBox" FontSize="18" Padding="12,9" TextChanged="Query_TextChanged"
             ToolTip="Search applications, zones, widgets and NextMind Desktop commands" />
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <ListBox x:Name="ResultsList" ItemTemplate="{StaticResource SearchResultTemplate}" />
      <TextBlock x:Name="EmptyText" Text="Type to search" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#FF8C98A8" FontSize="14" IsHitTestVisible="False" />
    </Grid>
    <TextBlock Grid.Row="2" Text="↑ ↓ navigate   Enter open   Esc close" Foreground="#FF8C98A8"
               FontSize="11.5" Margin="2,10,0,0" />
  </Grid>
</Window>
