<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- NEXTMIND FUTURE WORKSPACE V3: shared, dependency-free WPF design system. -->
  <Color x:Key="FutureAccentColor">#38BDF8</Color>
  <Color x:Key="FutureSecondaryAccentColor">#22D3C5</Color>
  <SolidColorBrush x:Key="FutureCanvasBrush" Color="#080C14" />
  <SolidColorBrush x:Key="FuturePanelBrush" Color="#E6101925" />
  <SolidColorBrush x:Key="FuturePanelAltBrush" Color="#D8172230" />
  <SolidColorBrush x:Key="FuturePanelRaisedBrush" Color="#F01A2635" />
  <SolidColorBrush x:Key="FutureBorderBrush" Color="#5A5E7895" />
  <SolidColorBrush x:Key="FutureBorderSubtleBrush" Color="#305E7895" />
  <SolidColorBrush x:Key="FutureAccentBrush" Color="{DynamicResource FutureAccentColor}" />
  <SolidColorBrush x:Key="FutureAccentSoftBrush" Color="#3338BDF8" />
  <SolidColorBrush x:Key="FutureAccentStrongBrush" Color="#DD38BDF8" />
  <SolidColorBrush x:Key="FutureSecondaryAccentBrush" Color="{DynamicResource FutureSecondaryAccentColor}" />
  <SolidColorBrush x:Key="FutureTextBrush" Color="#EEF6FF" />
  <SolidColorBrush x:Key="FutureMutedTextBrush" Color="#91A4B8" />
  <SolidColorBrush x:Key="FutureDisabledTextBrush" Color="#647487" />
  <SolidColorBrush x:Key="FutureWarningBrush" Color="#F4B860" />
  <SolidColorBrush x:Key="FutureDangerBrush" Color="#F06A78" />
  <SolidColorBrush x:Key="FutureSuccessBrush" Color="#4DDFC2" />
  <SolidColorBrush x:Key="AccentElectricBlueBrush" Color="#38BDF8" />
  <SolidColorBrush x:Key="AccentCyanBrush" Color="#22D3C5" />
  <SolidColorBrush x:Key="AccentVioletBrush" Color="#A778FF" />
  <SolidColorBrush x:Key="AccentAmberBrush" Color="#F4B860" />
  <Color x:Key="WorkspaceAccentColor">#38BDF8</Color>
  <SolidColorBrush x:Key="WorkspaceAccentBrush" Color="{DynamicResource WorkspaceAccentColor}" />
  <SolidColorBrush x:Key="WorkspaceAccentSoftBrush" Color="#4D38BDF8" />
  <SolidColorBrush x:Key="WorkspaceAccentStrongBrush" Color="#DD38BDF8" />
  <SolidColorBrush x:Key="WorkspaceContentBrush" Color="#E6101925" />
  <Duration x:Key="FutureMotionDuration">0:0:0.16</Duration>
  <system:Double x:Key="FuturePanelOpacity" xmlns:system="clr-namespace:System;assembly=System.Runtime">0.9</system:Double>
  <system:Double x:Key="FutureGlowOpacity" xmlns:system="clr-namespace:System;assembly=System.Runtime">0.385</system:Double>
  <system:Boolean x:Key="FutureEffectsEnabled" xmlns:system="clr-namespace:System;assembly=System.Runtime">True</system:Boolean>
  <DropShadowEffect x:Key="FuturePanelEffect" Color="#38BDF8" BlurRadius="18" ShadowDepth="0" Opacity="0.28" />
  <system:Double x:Key="WorkspaceContentOpacity" xmlns:system="clr-namespace:System;assembly=System.Runtime">0.9</system:Double>
  <system:Double x:Key="WorkspaceGlowOpacity" xmlns:system="clr-namespace:System;assembly=System.Runtime">0.385</system:Double>
  <system:Boolean x:Key="WorkspaceEffectsEnabled" xmlns:system="clr-namespace:System;assembly=System.Runtime">True</system:Boolean>
  <DropShadowEffect x:Key="WorkspacePanelEffect" Color="#38BDF8" BlurRadius="18" ShadowDepth="0" Opacity="0.385" />

  <Style x:Key="FutureWindowStyle" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource FutureCanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="FutureChromeButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FutureMutedTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ChromeShell" Background="{TemplateBinding Background}" CornerRadius="5" Margin="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ChromeShell" Property="Background" Value="{DynamicResource FutureAccentSoftBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ChromeShell" Property="BorderBrush" Value="{DynamicResource FutureSecondaryAccentBrush}" />
              <Setter TargetName="ChromeShell" Property="BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ChromeShell" Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FutureChromeCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource FutureChromeButtonStyle}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#B8C83D4D" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FuturisticScrollPageButtonStyle" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FuturisticScrollBarStyle" TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="Background" Value="{DynamicResource FuturePanelAltBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid x:Name="ScrollRoot" Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Focusable="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="DecreaseButton" Command="{x:Static ScrollBar.PageUpCommand}"
                              Style="{StaticResource FuturisticScrollPageButtonStyle}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="ScrollThumb" MinWidth="6" MinHeight="24"
                       Background="{DynamicResource FutureAccentStrongBrush}">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="2,1" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="IncreaseButton" Command="{x:Static ScrollBar.PageDownCommand}"
                              Style="{StaticResource FuturisticScrollPageButtonStyle}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto" />
              <Setter Property="Height" Value="10" />
              <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              <Setter TargetName="ScrollThumb" Property="MinWidth" Value="24" />
              <Setter TargetName="ScrollThumb" Property="MinHeight" Value="6" />
              <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
              <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource FutureAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ScrollThumb" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FuturisticScrollViewerStyle" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="PanningMode" Value="Both" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                       Style="{StaticResource FuturisticScrollBarStyle}"
                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{TemplateBinding VerticalOffset}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                       Style="{StaticResource FuturisticScrollBarStyle}"
                       Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{TemplateBinding HorizontalOffset}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
            <Border x:Name="ScrollCorner" Grid.Row="1" Grid.Column="1"
                    Background="{DynamicResource FuturePanelAltBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FuturisticResizeThumbStyle" TargetType="Thumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="GripShell" Background="{TemplateBinding Background}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="GripShell" Property="Background" Value="{DynamicResource WorkspaceAccentSoftBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HolographicPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource FuturePanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FutureBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Effect" Value="{DynamicResource FuturePanelEffect}" />
  </Style>

  <Style x:Key="FuturisticWidgetContainerStyle" TargetType="Border" BasedOn="{StaticResource HolographicPanelStyle}">
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="FuturisticWindowHeaderStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource FuturePanelAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FutureAccentSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <Style x:Key="FutureSectionLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FutureAccentBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="FutureCardTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="FutureMutedTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FutureMutedTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="FuturisticButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource FuturePanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FutureBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="13,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell" CornerRadius="8" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource FutureAccentBrush}" />
              <Setter TargetName="Shell" Property="Background" Value="{DynamicResource FutureAccentSoftBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource FutureSecondaryAccentBrush}" />
              <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shell" Property="Opacity" Value="0.78" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource FutureDisabledTextBrush}" />
              <Setter TargetName="Shell" Property="Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FuturisticPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FuturisticButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource FutureAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FutureAccentStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="FuturisticDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource FuturisticButtonStyle}">
    <Setter Property="BorderBrush" Value="{DynamicResource FutureDangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FutureDangerBrush}" />
  </Style>

  <Style x:Key="FuturisticTextBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource FuturePanelRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource FutureAccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource FutureAccentStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FutureBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource FutureAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FuturisticToggleStyle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Track" Width="36" Height="20" HorizontalAlignment="Left" CornerRadius="10"
                    Background="{DynamicResource FuturePanelRaisedBrush}" BorderBrush="{DynamicResource FutureBorderBrush}" BorderThickness="1">
              <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2" HorizontalAlignment="Left"
                       Fill="{DynamicResource FutureMutedTextBrush}" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource FutureAccentSoftBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FutureAccentBrush}" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource FutureAccentBrush}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FutureSecondaryAccentBrush}" />
              <Setter TargetName="Track" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FuturisticSliderStyle" TargetType="Slider">
    <Setter Property="Foreground" Value="{DynamicResource FutureAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource FuturePanelRaisedBrush}" />
    <Setter Property="IsSnapToTickEnabled" Value="False" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <Style x:Key="FuturisticAccentSelectorStyle" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource FuturePanelRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FutureBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style x:Key="FuturisticAccentItemStyle" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="Background" Value="#FF111B28" />
    <Setter Property="BorderBrush" Value="{DynamicResource FutureBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="AccentShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="AccentShell" Property="BorderBrush" Value="{DynamicResource FutureAccentBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="AccentShell" Property="Background" Value="{DynamicResource FutureAccentSoftBrush}" />
              <Setter TargetName="AccentShell" Property="BorderBrush" Value="{DynamicResource FutureAccentStrongBrush}" />
              <Setter TargetName="AccentShell" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="AccentShell" Property="BorderBrush" Value="{DynamicResource FutureSecondaryAccentBrush}" />
              <Setter TargetName="AccentShell" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FuturisticMenuStyle" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource FuturePanelRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FutureBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5" />
  </Style>

  <Style x:Key="FuturisticMenuItemStyle" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,7" />
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{DynamicResource FutureAccentSoftBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FuturisticTooltipStyle" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource FuturePanelRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FutureAccentSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,6" />
  </Style>

  <Style x:Key="FuturisticSearchResultStyle" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Foreground" Value="{DynamicResource FutureTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="ResultShell" CornerRadius="9" Padding="12,10" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="1">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ResultShell" Property="Background" Value="{DynamicResource FutureAccentSoftBrush}" />
              <Setter TargetName="ResultShell" Property="BorderBrush" Value="{DynamicResource FutureBorderSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ResultShell" Property="Background" Value="{DynamicResource FutureAccentSoftBrush}" />
              <Setter TargetName="ResultShell" Property="BorderBrush" Value="{DynamicResource FutureAccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="ResultShell" Property="BorderBrush" Value="{DynamicResource FutureSecondaryAccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FuturisticZoneItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource FuturisticSearchResultStyle}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0" />
  </Style>
</ResourceDictionary>
